load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_image_layer", "js_library", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.bazel.json",
    # module = nodenext picks ESM from "type" in package.json.
    deps = [
        "package.json",
        "tsconfig.json",
    ],
)

# src/ is split by what uses it: the image holds only SERVER_SRCS, and a
# change to a test or a tool leaves it alone. tsconfig.bazel.json lets a
# part import another's output.

# The server, and the library surface (index.ts) that //tests imports.
SERVER_SRCS = [
    "src/data.ts",
    "src/geo.ts",
    "src/handlers.ts",
    "src/icons.ts",
    "src/index.ts",
    "src/legal.ts",
    "src/limits.ts",
    "src/lines.ts",
    "src/main.ts",
    "src/page.ts",
    "src/proxyFetcher.ts",
    "src/server.ts",
]

TEST_SRCS = glob(["src/**/*.test.ts"])

ICON_SAMPLES_SRCS = ["src/iconSamples.ts"]

# A file in none of the parts would be left out of the build without a word.
[
    fail("%s is in none of the *_SRCS lists" % f)
    for f in glob(["src/**/*.ts"])
    if f not in SERVER_SRCS + TEST_SRCS + ICON_SAMPLES_SRCS
]

ts_project(
    name = "server_tsc",
    srcs = SERVER_SRCS,
    # declaration = True so //server:pkg exposes .d.ts for the "mvv-proxy"
    # library surface (src/index.ts) consumed by the //tests package, and so
    # the other parts here can import it.
    declaration = True,
    out_dir = "out",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/d3-quadtree",
        ":node_modules/@types/express",
        ":node_modules/@types/node",
        ":node_modules/@types/node-fetch",
        ":node_modules/d3-quadtree",
        ":node_modules/express",
        ":node_modules/node-fetch",
        ":node_modules/shared",
        ":node_modules/socks-proxy-agent",
        ":node_modules/yaml",
    ],
)

ts_project(
    name = "tests_tsc",
    srcs = TEST_SRCS,
    declaration = True,
    out_dir = "out",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/d3-quadtree",
        ":node_modules/@types/express",
        ":node_modules/@types/node",
        ":node_modules/d3-quadtree",
        ":node_modules/express",
        ":node_modules/shared",
        ":server_tsc",
    ],
)

ts_project(
    name = "icon_samples_tsc",
    srcs = ICON_SAMPLES_SRCS,
    declaration = True,
    out_dir = "out",
    root_dir = "src",
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/node",
        ":server_tsc",
    ],
)

# Target name "pkg" is the npm_package_target_name convention rules_js uses to
# link first-party workspace packages; lets //tests import "mvv-proxy".
js_library(
    name = "pkg",
    srcs = ["package.json"],
    visibility = ["//visibility:public"],
    deps = [":server_tsc"],
)

# chdir = "server" (this package) so that server.ts's cwd-relative paths
# (express.static("../www/"), express.static("../fonts"), "./data/stops.csv")
# resolve the same way they do when run outside Bazel from the server/ dir.
js_binary(
    name = "server_bin",
    chdir = package_name(),
    data = [
        "package.json",
        ":server_tsc",
        "//fonts",
        "//server/data:stops",
        "//www",
    ],
    entry_point = "out/main.js",
    visibility = ["//visibility:public"],
)

# Redraws the sample icons in docs/icons (see docs/MVV-ICONS.md).
js_binary(
    name = "icon_samples",
    data = [
        "package.json",
        ":icon_samples_tsc",
    ],
    entry_point = "out/iconSamples.js",
)

js_test(
    name = "geo_test",
    chdir = package_name(),
    data = [
        "package.json",
        ":tests_tsc",
        "//server/data:stops",
        "//server/data:stops_for_testing",
    ],
    entry_point = "out/geo.test.js",
    size = "small",
)

js_test(
    name = "handlers_test",
    data = [
        "package.json",
        ":tests_tsc",
    ],
    entry_point = "out/handlers.test.js",
    size = "small",
)

js_test(
    name = "icons_test",
    data = [
        "package.json",
        ":tests_tsc",
    ],
    entry_point = "out/icons.test.js",
    size = "small",
)

js_test(
    name = "legal_test",
    chdir = package_name(),
    data = [
        "package.json",
        ":tests_tsc",
        "//server/data:operator_example",
    ],
    entry_point = "out/legal.test.js",
    size = "small",
)

js_test(
    name = "page_test",
    data = [
        "package.json",
        ":tests_tsc",
    ],
    entry_point = "out/page.test.js",
    size = "small",
)

js_test(
    name = "limits_test",
    data = [
        "package.json",
        ":tests_tsc",
    ],
    entry_point = "out/limits.test.js",
    size = "small",
)

# Talks to a local HTTP server standing in for MVV.
js_test(
    name = "proxy_fetcher_test",
    data = [
        "package.json",
        ":tests_tsc",
    ],
    entry_point = "out/proxyFetcher.test.js",
    size = "small",
)

# --- Container image, replacing Dockerfile / docker-build / docker-push ---

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

js_image_layer(
    name = "server_layer",
    binary = ":server_bin",
    platform = select({
        "@platforms//cpu:arm64": ":linux_arm64",
        "@platforms//cpu:x86_64": ":linux_amd64",
    }),
    root = "/app",
    tags = ["no-remote-exec"],
)

oci_image(
    name = "image",
    # js_binary's launcher is a bash script, so the base needs bash. bash is
    # an Essential package in Debian, so node:26-trixie-slim still ships it at
    # /usr/bin/bash (see @node_base in MODULE.bazel). The Node that runs comes
    # from :server_layer, not from the base.
    base = "@node_base",
    # `/[js_image_layer root]/[package of the binary target]/[binary name]`
    cmd = ["/app/server/server_bin"],
    entrypoint = ["/usr/bin/bash"],
    # Departures near midnight depend on local time (see queryDepartures.ts),
    # and the image would otherwise run on UTC.
    env = {"TZ": "Europe/Berlin"},
    # The server listens on 3000; declaring it here adds EXPOSE metadata so
    # tools (e.g. Docker Desktop's Run dialog) can offer a host-port mapping.
    exposed_ports = ["3000/tcp"],
    tars = [":server_layer"],
    # `cmd` + `.runfiles/[workspace name]`
    workdir = "/app/server/server_bin.runfiles/_main",
)

oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["mvv-proxy:v0"],
)

oci_push(
    name = "image_push",
    image = ":image",
    repository = "docker.io/mulambda/mvv-proxy",
    remote_tags = ["v0"],
)
